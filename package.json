{
  "name": "serverless-loan-orchestrator",
  "version": "0.1.0",
  "description": "Serverless fintech loan orchestrator",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "deploy:local": "serverless deploy --stage local --aws-profile ger-local",
    "remove:local": "serverless remove --stage local --aws-profile ger-local",
    "logs:local": "serverless logs --stage local -f"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-sfn": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.1038.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "uuid": "^9.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "aws-sdk-client-mock": "^4.0.0",
    "aws-sdk-client-mock-jest": "^4.0.0",
    "esbuild": "^0.27.4",
    "jest": "^29.0.0",
    "serverless": "^4",
    "serverless-iam-roles-per-function": "^3.2.0",
    "serverless-localstack": "^1.4.0",
    "serverless-step-functions": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
